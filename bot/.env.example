# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Discord Application ID (from Discord Developer Portal)
CLIENT_ID=your_application_id_here

# Canal de Discord donde se guardan las canciones descargadas (el bot necesita Ver canal, Leer historial,
# Enviar mensajes y Adjuntar archivos ahí). Si no lo pones, usa 1557170112023363625.
SONGS_CHANNEL_ID=1557170112023363625

# OPCIONAL - solo si YouTube bloquea al servidor ("Sign in to confirm you're not a bot"):
# contenido completo de un cookies.txt (formato Netscape) de una cuenta de YouTube/Google DESECHABLE.
# YT_COOKIES=
# YT_PROXY=http://usuario:clave@host:puerto
# MAX_SONG_SECONDS=10800
